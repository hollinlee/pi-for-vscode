{
  "name": "pi-for-vscode",
  "displayName": "Pi for VS Code",
  "description": "Use your installed pi coding agent from VS Code.",
  "version": "0.0.4",
  "publisher": "hollinlee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hollinlee/pi-for-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/hollinlee/pi-for-vscode/issues"
  },
  "homepage": "https://github.com/hollinlee/pi-for-vscode#readme",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:pi.sidebar",
    "onView:pi.launcher"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pi can execute tools and project extensions, so a trusted workspace is required."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-for-vscode-launcher",
          "title": "Open Pi",
          "icon": "media/pi.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "pi-for-vscode",
          "title": "Pi",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "pi-for-vscode-launcher": [
        {
          "id": "pi.launcher",
          "name": "Open Pi"
        }
      ],
      "pi-for-vscode": [
        {
          "id": "pi.sidebar",
          "name": "Pi",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "pi.open",
        "title": "Pi: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pi.refreshConnection",
        "title": "Pi: Refresh Connection",
        "icon": "$(refresh)"
      },
      {
        "command": "pi.openSettings",
        "title": "Pi: Open Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "configuration": {
      "title": "Pi",
      "properties": {
        "pi.executablePath": {
          "type": "string",
          "default": "pi",
          "scope": "machine-overridable",
          "description": "Path or command used to launch pi in the current Extension Host."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:vscode": "node test/run-vscode-tests.mjs",
    "smoke:rpc": "node test/smoke/rpc-smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "package": "npm run build && npx --yes @vscode/vsce@3.9.2 package --no-dependencies --out pi-for-vscode-${npm_package_version}.vsix"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.10"
  }
}
